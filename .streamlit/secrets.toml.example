# Copy these names into Streamlit Cloud's Secrets settings or into a local
# .streamlit/secrets.toml file. Never commit real credentials.
GEMINI_API_KEY = "replace-with-the-deployment-key"
APIFY_TOKEN = "replace-with-the-deployment-token"

[tagging_workers]
# Applies to the existing Streamlit execution path. Start conservatively and
# raise this only after a controlled concurrent load test.
max_concurrent_jobs = 3

# Optional multi-user beta backend. Leave this whole section absent to keep
# the existing Streamlit execution path.
[cloud_backend]
url = "https://replace-with-cloud-run-url"
api_key = "replace-with-backend-access-key"
poll_seconds = 3
