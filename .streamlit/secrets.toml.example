# Copy these names into Streamlit Cloud's Secrets settings or into a local
# .streamlit/secrets.toml file. Never commit real credentials.
GEMINI_API_KEY = "replace-with-the-deployment-key"
APIFY_TOKEN = "replace-with-the-deployment-token"

# Optional shared-beta safeguards. These safe defaults are also used when this
# section is omitted.
[apify_guard]
enabled = true
warning_usd = 8.00
stop_usd = 8.70
emergency_stop_usd = 9.50
fail_closed = true

# Optional private owner alerts. Use a deployment-managed SMTP account and
# never commit its real password. Ordinary app users do not see spend amounts.
[apify_guard_email]
enabled = false
owner_email = "owner@example.com"
sender_email = "tagger@example.com"
smtp_host = "smtp.example.com"
smtp_port = 587
smtp_username = "tagger@example.com"
smtp_password = "replace-with-the-smtp-password"
use_tls = true
use_ssl = false
